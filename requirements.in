# Direct runtime dependencies of edgemanage.
#
# This file is the hand-edited source. The lock is requirements.txt, which is
# generated and must not be edited by hand:
#
#   uv pip compile requirements.in -o requirements.txt \
#       --python-version 3.11 --generate-hashes
#
# Versions are pinned to what the production server actually runs (captured
# from `pip freeze` on 2026-09-17). Transitive pins from that same snapshot
# live in constraints.txt. Exceptions, moved ahead of that snapshot on
# 2026-10-23 to fix pip-audit advisories, along with the move to Python 3.11:
# Jinja2, requests and urllib3 here, certifi and idna in constraints.txt.
-c constraints.txt

ipaddr==2.2.0
Jinja2==3.1.6
prometheus_client==0.17.1
PyYAML==6.0.1
requests==2.34.2
setproctitle==1.3.3
six==1.12.0

# Imported directly by edgetest.py, which calls disable_warnings() on
# InsecureRequestWarning. It resolved before only because requests happens to
# require it, so a change upstream in requests could have broken the import
# with this lock still satisfied. Declared here so it stands on its own.
urllib3==2.8.0

# setuptools is deliberately absent. edge_manage used to import pkg_resources
# for --version, which made it an undeclared runtime dependency and forced a
# `setuptools<81` cap to stay ahead of pkg_resources' removal; it now uses
# importlib.metadata from the stdlib. setuptools is still needed to *build*
# the package, which pyproject.toml declares.
